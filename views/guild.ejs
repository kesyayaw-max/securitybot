<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/style.css"><title><%= guild.name %></title></head><body><nav><div><b>⚙️ <%= guild.name %></b><span>Live Config Editor</span></div><a class="ghost" href="/">Back</a></nav><main><% if (saved) { %><div class="ok">Config berhasil disimpan.</div><% } %><% if (error) { %><div class="err"><%= error %></div><% } %><form class="card form" method="POST" action="/guild/<%= guild.id %>/config"><h1>Security Config</h1><div class="toggles"><% [["securityEnabled","Security"],["antiInvite","Anti Invite"],["antiSpam","Anti Spam"],["antiBadword","Anti Badword"],["antiCaps","Anti Caps"],["antiMention","Anti Mention"],["antiRaid","Anti Raid"],["antiNuke","Anti Nuke"]].forEach(([k,l])=>{ %><label><span><%= l %></span><input type="checkbox" name="<%= k %>" <%= cfg[k] ? "checked" : "" %>></label><% }) %></div><div class="fields"><label>Spam Limit<input type="number" name="spamLimit" value="<%= cfg.spamLimit %>"></label><label>Spam Time Detik<input type="number" name="spamTime" value="<%= Math.floor(cfg.spamTime/1000) %>"></label><label>Mention Limit<input type="number" name="mentionLimit" value="<%= cfg.mentionLimit %>"></label><label>Caps Percent<input type="number" name="capsPercent" value="<%= cfg.capsPercent %>"></label><label>Timeout<input name="punishmentDuration" value="<%= cfg.punishmentDuration %>"></label><label>Raid Limit<input type="number" name="raidJoinLimit" value="<%= cfg.raidJoinLimit %>"></label><label>Raid Time Detik<input type="number" name="raidJoinTime" value="<%= Math.floor(cfg.raidJoinTime/1000) %>"></label><label>Bad Words<input name="badWords" value="<%= (cfg.badWords || []).join(', ') %>"></label><label>Log Channel<select name="logChannelId"><option value="">Tidak diset</option><% channels.forEach(c=>{ %><option value="<%= c.id %>" <%= cfg.logChannelId === c.id ? "selected" : "" %>>#<%= c.name %></option><% }) %></select></label><label>Whitelist Role<select name="whitelistRoleId"><option value="">Tidak diset</option><% roles.forEach(r=>{ %><option value="<%= r.id %>" <%= cfg.whitelistRoleId === r.id ? "selected" : "" %>>@<%= r.name %></option><% }) %></select></label></div><button>Save Live Config</button></form></main></body></html>