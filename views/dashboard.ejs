<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/style.css"><title>SQS Dashboard</title></head><body><nav><div><b>🛡️ SQS Dashboard</b><span>Bot: <%= bot?.tag || "-" %> • DB: <%= dbStatus %></span></div><form method="POST" action="/logout"><button class="ghost">Logout</button></form></nav><main><section class="hero"><h1>Public Bot Control Center</h1><p>Pilih server untuk live edit config.</p></section><section class="grid"><% guilds.forEach(g => { %><a class="card guild" href="/guild/<%= g.id %>"><h3><%= g.name %></h3><p><%= g.memberCount || 0 %> members</p></a><% }) %></section></main></body></html>